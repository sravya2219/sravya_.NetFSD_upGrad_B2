@model List<StudentDemo.Models.Student>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<html>
    <head>
        <title>All students</title>
    </head>
    <body>
        <h3>All studnet details</h3>
             <a asp-route="Add">Add Student</a>
        <table>
            <thead>
                <tr>
                <th>Student Name</th>
                <th>Student Age</th>
                <th>Student Course</th>
                </tr>
            </thead>
        @{
                foreach(var student in Model)
                {
                 <tr>
                 <td>@student.Name</td>
                 <td>@student.Age</td>
                 <td>@student.Course</td>

                 
                 </tr> 
                 
                }
            }

        </table>
    </body>
</html>