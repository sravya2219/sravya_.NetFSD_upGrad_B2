@model StudentDemo.Models.Student
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<html>
    <head>
        <title>Add student</title>
    </head>
    <body>
      <a asp-route="Get">Student List</a>

    <h3>Enter Contact Details</h3>

    <form asp-route="Save" method="post">

    

        <div>
            <label>Student Name:</label>
            <input asp-for="Name" placeholder="enter student name" />
        </div>

   
        <div>
            <label>Student Age:</label>
            <input asp-for="Age" placeholder="enter student age" />
        </div>

        <div>
            <label>Student Course:</label>
            <input asp-for="Course" placeholder="enter student course" />
        </div>

    
        <div>
            <input type="submit" value="Add Student" />
        </div>

    </form>

    </body>
</html>